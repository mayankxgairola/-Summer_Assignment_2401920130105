class Solution {
public:
    void reversePart(string &s, int i, int j) {
        while(i <= j) {
            swap(s[i], s[j]);
            i++, j--;
        }
    }

    string reverseWords(string s) {
        int i = 0, j = 0;

        while(j < s.length()) {
            if(s[j] == ' ') {
                reversePart(s, i, j - 1);
                i = j + 1;
                j = i;
            }

            j++;
        }

        reversePart(s, i, s.length() - 1);

        return s;
    }
};
